@model List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.CategoryViewModel>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">Category Management</h2>
        <p class="text-muted mb-0">Manage news categories and sections</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCatModal">
        <i class="bi bi-plus-circle me-1"></i> Add Category
    </button>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold">@c.CategoryId</td>
                        <td class="fw-semibold">@c.CategoryName</td>
                        <td class="text-muted">@c.CategoryDesciption</td>
                        <td>
                            @if (c.IsActive == true)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-warning me-1" onclick='openEditCatModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(c)))'>
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="openDeleteCatModal('@c.CategoryId', '@c.CategoryName')">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Create Category -->
<div class="modal fade" id="createCatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">Add Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name *</label>
                        <input name="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description *</label>
                        <textarea name="CategoryDesciption" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="catActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="catActiveSwitch">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Category -->
<div class="modal fade" id="editCatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                <input type="hidden" name="CategoryId" id="editCatId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">Edit Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name *</label>
                        <input name="CategoryName" id="editCatName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description *</label>
                        <textarea name="CategoryDesciption" id="editCatDesc" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editCatActive" />
                        <label class="form-check-label fw-semibold" for="editCatActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Delete Category Confirm -->
<div class="modal fade" id="deleteCatConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteCatId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">Confirm Delete Category</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 mb-1">Are you sure you want to delete this category?</p>
                    <p class="fw-bold text-danger fs-6" id="deleteCatTitle"></p>
                    <p class="text-muted small">Rule: Categories containing existing news articles cannot be deleted.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditCatModal(c) {
        document.getElementById('editCatId').value = c.CategoryId;
        document.getElementById('editCatName').value = c.CategoryName;
        document.getElementById('editCatDesc').value = c.CategoryDesciption;
        document.getElementById('editCatActive').checked = (c.IsActive === true);
        new bootstrap.Modal(document.getElementById('editCatModal')).show();
    }
    function openDeleteCatModal(id, name) {
        document.getElementById('deleteCatId').value = id;
        document.getElementById('deleteCatTitle').innerText = name;
        new bootstrap.Modal(document.getElementById('deleteCatConfirmModal')).show();
    }
</script>
}