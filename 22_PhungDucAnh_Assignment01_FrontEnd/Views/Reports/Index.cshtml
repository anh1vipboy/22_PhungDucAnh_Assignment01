@model _22_PhungDucAnh_Assignment01_FrontEnd.Models.ReportViewModel
@{
    ViewData["Title"] = "Report Statistics";
}

<div class="mb-4">
    <h2 class="fw-bold"><i class="bi bi-bar-chart-line text-primary me-1"></i> Report Statistics</h2>
    <p class="text-muted">Generate statistical reports on news articles created within a specified date period</p>
</div>

<div class="card p-4 mb-4 shadow-sm">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4 d-grid">
            <button type="submit" class="btn btn-primary"><i class="bi bi-graph-up me-1"></i> Generate Report</button>
        </div>
    </form>
</div>

<!-- Summary Card -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white p-3 shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 text-uppercase mb-1">Total News Articles</h6>
                    <h2 class="fw-bold mb-0">@Model.TotalArticles</h2>
                </div>
                <i class="bi bi-newspaper fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light fw-bold py-3">
        Articles Created (Sorted by Created Date Descending)
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Title & Headline</th>
                    <th>Category</th>
                    <th>Created By</th>
                    <th>Created Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Articles == null || !Model.Articles.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No news articles found in the selected date range.</td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model.Articles)
                    {
                        <tr>
                            <td class="fw-bold">@a.NewsArticleId</td>
                            <td>
                                <div class="fw-bold">@a.NewsTitle</div>
                                <small class="text-muted">@a.Headline</small>
                            </td>
                            <td><span class="badge bg-info-subtle text-info border">@a.CategoryName</span></td>
                            <td>@a.CreatedByName</td>
                            <td>@(a.CreatedDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                            <td>
                                @if (a.NewsStatus == true)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>