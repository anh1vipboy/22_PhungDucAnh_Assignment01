@model List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "My News History";
}

<div class="mb-4">
    <h2 class="fw-bold"><i class="bi bi-clock-history me-1 text-primary"></i> My Created News History</h2>
    <p class="text-muted">Viewing all articles created by your staff account</p>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Title & Headline</th>
                    <th>Category</th>
                    <th>Created Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">You have not created any news articles yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.NewsArticleId</td>
                            <td>
                                <div class="fw-bold">@item.NewsTitle</div>
                                <small class="text-muted">@item.Headline</small>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary border">@(item.Category?.CategoryName ?? "General")</span></td>
                            <td>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                            <td>
                                @if (item.NewsStatus == true)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>