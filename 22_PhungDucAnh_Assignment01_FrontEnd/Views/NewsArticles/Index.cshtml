@model List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "Manage News Articles";
    var categories = ViewBag.Categories as List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.CategoryViewModel> ?? new();
    var tags = ViewBag.Tags as List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.TagViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">News Articles Management</h2>
        <p class="text-muted mb-0">Create, update, search, and manage campus news articles</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createNewsModal">
        <i class="bi bi-plus-circle me-1"></i> Add New Article
    </button>
</div>

<!-- Search Filter -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-2">
        <div class="col-md-7">
            <input type="text" name="search" class="form-control" placeholder="Search by title or headline..." value="@ViewBag.CurrentSearch" />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select">
                <option value="">-- All Categories --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryId" selected="@(ViewBag.CurrentCategory == c.CategoryId ? "selected" : null)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-search me-1"></i> Search</button>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Title & Headline</th>
                    <th>Category</th>
                    <th>Created Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No news articles found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.NewsArticleId</td>
                            <td>
                                <div class="fw-bold text-dark">@item.NewsTitle</div>
                                <small class="text-muted">@item.Headline</small>
                            </td>
                            <td><span class="badge bg-info-subtle text-info border">@(item.Category?.CategoryName ?? "N/A")</span></td>
                            <td>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                            <td>
                                @if (item.NewsStatus == true)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-warning me-1" onclick='openEditNewsModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item)))'>
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal('@item.NewsArticleId', '@item.NewsTitle')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Create -->
<div class="modal fade" id="createNewsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-1"></i> Add News Article</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Article ID</label>
                            <input name="NewsArticleId" class="form-control" placeholder="Auto-generated if empty" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">News Title *</label>
                            <input name="NewsTitle" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Headline *</label>
                            <input name="Headline" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category *</label>
                            <select name="CategoryId" class="form-select" required>
                                <option value="">-- Choose Category --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">News Source</label>
                            <input name="NewsSource" class="form-control" placeholder="e.g. FU Newsroom" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Content *</label>
                            <textarea name="NewsContent" class="form-control" rows="5" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Select Tags</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var t in tags)
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="selectedTags" value="@t.TagId" id="tag_@t.TagId" />
                                        <label class="form-check-label" for="tag_@t.TagId">@t.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="NewsStatus" value="true" checked id="statusSwitch" />
                                <label class="form-check-label fw-semibold" for="statusSwitch">Active (Publicly Visible)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Create Article</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit -->
<div class="modal fade" id="editNewsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                <input type="hidden" name="NewsArticleId" id="editArticleId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil me-1"></i> Edit News Article</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">News Title *</label>
                            <input name="NewsTitle" id="editNewsTitle" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Headline *</label>
                            <input name="Headline" id="editHeadline" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category *</label>
                            <select name="CategoryId" id="editCategoryId" class="form-select" required>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">News Source</label>
                            <input name="NewsSource" id="editNewsSource" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Content *</label>
                            <textarea name="NewsContent" id="editNewsContent" class="form-control" rows="5" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Select Tags</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var t in tags)
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input edit-tag-check" type="checkbox" name="selectedTags" value="@t.TagId" id="edit_tag_@t.TagId" />
                                        <label class="form-check-label" for="edit_tag_@t.TagId">@t.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="NewsStatus" value="true" id="editNewsStatus" />
                                <label class="form-check-label fw-semibold" for="editNewsStatus">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4">Update Article</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Delete Confirm -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-1"></i> Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 mb-1">Are you sure you want to delete this article?</p>
                    <p class="fw-bold text-danger fs-6" id="deleteTitle"></p>
                    <p class="text-muted small">This action cannot be undone.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete Permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditNewsModal(item) {
        document.getElementById('editArticleId').value = item.NewsArticleId || '';
        document.getElementById('editNewsTitle').value = item.NewsTitle || '';
        document.getElementById('editHeadline').value = item.Headline || '';
        document.getElementById('editCategoryId').value = item.CategoryId || '';
        document.getElementById('editNewsSource').value = item.NewsSource || '';
        document.getElementById('editNewsContent').value = item.NewsContent || '';
        document.getElementById('editNewsStatus').checked = (item.NewsStatus === true);

        // Reset tags
        document.querySelectorAll('.edit-tag-check').forEach(chk => chk.checked = false);
        if (item.Tags) {
            item.Tags.forEach(t => {
                const el = document.getElementById(`edit_tag_${t.TagId}`);
                if (el) el.checked = true;
            });
        }

        new bootstrap.Modal(document.getElementById('editNewsModal')).show();
    }

    function openDeleteModal(id, title) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteTitle').innerText = title;
        new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
    }
</script>
}