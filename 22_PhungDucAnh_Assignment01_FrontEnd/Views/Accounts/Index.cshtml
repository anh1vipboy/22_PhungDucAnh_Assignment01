@model List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.AccountViewModel>
@{
    ViewData["Title"] = "Manage Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">System Account Management</h2>
        <p class="text-muted mb-0">Admin view: Manage Staff and Lecturer accounts</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAccModal">
        <i class="bi bi-person-plus me-1"></i> Add Account
    </button>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-bold">@a.AccountId</td>
                        <td class="fw-semibold">@a.AccountName</td>
                        <td>@a.AccountEmail</td>
                        <td>
                            @if (a.AccountRole == 1)
                            {
                                <span class="badge bg-primary">Staff</span>
                            }
                            else if (a.AccountRole == 2)
                            {
                                <span class="badge bg-info text-dark">Lecturer</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Other</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-warning me-1" onclick='openEditAccModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(a)))'>
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="openDeleteAccModal('@a.AccountId', '@a.AccountName')">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Create Account -->
<div class="modal fade" id="createAccModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">Create Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name *</label>
                        <input name="AccountName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email *</label>
                        <input name="AccountEmail" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password *</label>
                        <input name="AccountPassword" type="password" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role *</label>
                        <select name="AccountRole" class="form-select">
                            <option value="1">Staff (Role 1)</option>
                            <option value="2">Lecturer (Role 2)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Account -->
<div class="modal fade" id="editAccModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                <input type="hidden" name="AccountId" id="editAccId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">Edit Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name *</label>
                        <input name="AccountName" id="editAccName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email *</label>
                        <input name="AccountEmail" id="editAccEmail" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role *</label>
                        <select name="AccountRole" id="editAccRole" class="form-select">
                            <option value="1">Staff (Role 1)</option>
                            <option value="2">Lecturer (Role 2)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password (leave blank to keep current)</label>
                        <input name="AccountPassword" type="password" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Delete Account Confirm -->
<div class="modal fade" id="deleteAccConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteAccId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">Confirm Delete Account</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 mb-1">Are you sure you want to delete this account?</p>
                    <p class="fw-bold text-danger fs-6" id="deleteAccTitle"></p>
                    <p class="text-muted small">Rule: Accounts that have already created news articles cannot be deleted.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditAccModal(a) {
        document.getElementById('editAccId').value = a.AccountId;
        document.getElementById('editAccName').value = a.AccountName || '';
        document.getElementById('editAccEmail').value = a.AccountEmail || '';
        document.getElementById('editAccRole').value = a.AccountRole || 1;
        new bootstrap.Modal(document.getElementById('editAccModal')).show();
    }
    function openDeleteAccModal(id, name) {
        document.getElementById('deleteAccId').value = id;
        document.getElementById('deleteAccTitle').innerText = name;
        new bootstrap.Modal(document.getElementById('deleteAccConfirmModal')).show();
    }
</script>
}