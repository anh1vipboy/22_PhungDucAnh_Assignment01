@model List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "Campus News";
    var categories = ViewBag.Categories as List<_22_PhungDucAnh_Assignment01_FrontEnd.Models.CategoryViewModel> ?? new();
}

<div class="bg-primary text-white p-5 rounded-4 mb-4 shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold mb-2">FU News & Announcements</h1>
            <p class="lead mb-0 text-white-50">Stay updated with the latest research, campus events, and academic breakthroughs.</p>
        </div>
        <div class="col-md-4 text-end">
            <span class="badge bg-white text-primary px-3 py-2 fs-6 shadow-sm"><i class="bi bi-check-circle-fill text-success me-1"></i> Active News Only</span>
        </div>
    </div>
</div>

<!-- Search and Category Filters -->
<div class="card p-3 mb-4 shadow-sm">
    <form method="get" class="row g-2">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Search by title or headline..." value="@ViewBag.CurrentSearch" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select">
                <option value="">-- All Categories --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryId" selected="@(ViewBag.CurrentCategory == c.CategoryId ? "selected" : null)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
        </div>
    </form>
</div>

<!-- News Cards Grid -->
@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox fs-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No news articles found.</h4>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-all hover-shadow">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                <i class="bi bi-tag-fill me-1"></i>@(item.Category?.CategoryName ?? "General")
                            </span>
                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@(item.CreatedDate?.ToString("MMM dd, yyyy"))</small>
                        </div>
                        <h5 class="card-title fw-bold text-dark mt-1">@item.NewsTitle</h5>
                        <p class="card-text text-muted flex-grow-1">@item.Headline</p>
                        
                        @if (item.Tags != null && item.Tags.Any())
                        {
                            <div class="mb-3">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="badge bg-light text-secondary border me-1">#@tag.TagName</span>
                                }
                            </div>
                        }

                        <button class="btn btn-outline-primary w-100 mt-2" onclick="showNewsDetail('@item.NewsArticleId')">
                            <i class="bi bi-eye me-1"></i> Read Article
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Detail Modal -->
<div class="modal fade" id="newsDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="detailTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between text-muted mb-3 border-bottom pb-2">
                    <span id="detailCategory" class="badge bg-primary"></span>
                    <span id="detailDate"></span>
                </div>
                <h6 class="fw-semibold text-secondary" id="detailHeadline"></h6>
                <div class="mt-3 fs-6" id="detailContent" style="white-space: pre-wrap; line-height: 1.7;"></div>
                <div class="mt-4 pt-3 border-top d-flex justify-content-between text-muted small">
                    <span>Source: <strong id="detailSource"></strong></span>
                    <span>Author: <strong id="detailAuthor"></strong></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function showNewsDetail(id) {
        try {
            const res = await fetch(`/Home/GetDetail?id=${id}`);
            if (!res.ok) return;
            const data = await res.json();
            document.getElementById('detailTitle').innerText = data.newsTitle || '';
            document.getElementById('detailHeadline').innerText = data.headline || '';
            document.getElementById('detailCategory').innerText = data.category ? data.category.categoryName : 'General';
            document.getElementById('detailDate').innerText = data.createdDate ? new Date(data.createdDate).toLocaleDateString() : '';
            document.getElementById('detailContent').innerText = data.newsContent || '';
            document.getElementById('detailSource').innerText = data.newsSource || 'N/A';
            document.getElementById('detailAuthor').innerText = data.createdBy ? data.createdBy.accountName : 'N/A';
            
            new bootstrap.Modal(document.getElementById('newsDetailModal')).show();
        } catch (e) {
            console.error(e);
        }
    }
</script>
}